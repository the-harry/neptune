[Unit]
Description=NEPTUNE control API (ROV + WOLFANG camera control plane)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=neptune
WorkingDirectory=/opt/neptune/api
# venv with requirements.txt installed
ExecStart=/opt/neptune/api/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
# "auto" tries the real GPIO backend and falls back to the bench simulator if the
# sensor wiring is not in place. Forcing "real" made the API publish constants as
# genuine readings with mock=false, which is worse than an honest simulation.
Environment=NEPTUNE_HW=auto
Environment=NEPTUNE_CAM=none
Environment=NEPTUNE_CLIENT_DIR=/opt/neptune/client
Environment=WOLFANG_BASE=http://192.72.1.1
Environment=ROV_LOG_DIR=/var/log/rov
# blackbox flight recorder writes here; LogsDirectory creates + owns /var/log/rov
LogsDirectory=rov
# Camera capability cache (which write names and values this firmware actually
# honours). StateDirectory creates + owns /var/lib/neptune for the service user.
# Losing it is harmless - it only costs a re-probe on the next connect.
StateDirectory=neptune
Environment=WOLFANG_CAPS_PATH=/var/lib/neptune/camera-caps.json
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
