# Line endings are not cosmetic in this repo: the Pi half is executed by bash and
# systemd, and a single stray CR breaks it in ways that are hard to read. `set -euo
# pipefail\r` fails with "pipefail: invalid option name", and a systemd
# `Environment=X=y\r` silently puts a CR inside the value.
#
# The topside half is the mirror image: PowerShell 5.1 reads .ps1 as ANSI and wants
# CRLF, and .bat genuinely requires it.

* text=auto

# ---- Pi side: ALWAYS LF, whatever the checkout platform does ----
*.sh          text eol=lf
*.service     text eol=lf
*.conf        text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.py          text eol=lf

# ---- topside (Windows) side: ALWAYS CRLF ----
*.ps1         text eol=crlf
*.bat         text eol=crlf
*.cmd         text eol=crlf

# ---- binary ----
*.ico         binary
*.png         binary
*.jpg         binary
*.woff2       binary
