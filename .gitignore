# Agent / editor tooling — local to a machine, never part of the vehicle.
.claude/
CLAUDE.md
.kiro/
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/

# Runtime data written by the Pi (dive logs, offline areas, blackbox)
data/
*.jsonl

# Everything a topside session produces: stills, screen recordings, session logs.
# The FOLDERS are part of the layout; their contents are the operator's, not the
# repo's - a single dive can be hundreds of MB of video.
client/navigation_logs/**
!client/navigation_logs/
!client/navigation_logs/*/
!client/navigation_logs/**/.gitkeep

# ffmpeg, if it is vendored next to the launcher instead of installed
client/launch/bin/

# OS noise
Thumbs.db
.DS_Store

# Test screenshots: captured every run, and a live instrument never photographs
# identically twice. The BASELINE is committed; what a run saw is not.
client/tests/screenshots/

# mypy's incremental cache. lint.py points mypy at a cache under the system temp
# so a check never leaves anything in the tree, but a bare `mypy api/` run by hand
# still drops one here.
.mypy_cache/
